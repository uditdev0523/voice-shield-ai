# VoiceShield AI Environment Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
DEBUG=false

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Audio Upload & Processing Settings
MAX_UPLOAD_SIZE_BYTES=10485760   # 10 MB limit
MAX_AUDIO_DURATION_SECONDS=60.0  # Max 60 seconds
DEFAULT_SAMPLE_RATE=16000

# Privacy & Retention Configuration
ENABLE_AUDIO_RETENTION=false     # STRICT DEFAULT: Raw audio is NEVER stored permanently
TEMP_AUDIO_DIR=backend/data/temp_audio
AUDIT_DB_PATH=backend/data/audit/voiceshield_audit.db

# Model Configuration
MODEL_CHECKPOINT_PATH=backend/data/models/voiceshield_best.pt
MODEL_DEVICE=cpu                 # cpu or cuda
MODEL_VERSION=v1.0.0-cnn-bigru

# Risk Decision Engine Thresholds
RISK_THRESHOLD_LOW=0.35
RISK_THRESHOLD_HIGH=0.70
HIGH_TRANSACTION_AMOUNT_THRESHOLD=5000.0
